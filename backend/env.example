# OPAL Unified System - Environment Configuration
# Copy this file to .env and update the values

# Application
DEBUG=false
APP_NAME="OPAL Unified System"
APP_VERSION="1.0.0"

# MariaDB Configuration
MARIADB_HOST=localhost
MARIADB_PORT=3306
MARIADB_USER=opal
MARIADB_PASSWORD=your_secure_password_here
MARIADB_DATABASE=opal

# Security
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
ALLOWED_ORIGINS=["http://localhost:3000", "http://localhost:8080"]

# Database URLs (auto-generated from above)
# DATABASE_URL=mysql+pymysql://opal:password@localhost:3306/opal
# ASYNC_DATABASE_URL=mysql+aiomysql://opal:password@localhost:3306/opal

# Explicit async URLs by domain
MARIADB_ASYNC_DATABASE_URL=mysql+aiomysql://opal:password@localhost:3306/opal

# Summit Logging (Postgres)
SUMMIT_ASYNC_DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/opal_summit
# Optional: sync driver URL for ETL scripts (defaults derived from SUMMIT_ASYNC_DATABASE_URL)
# SUMMIT_SYNC_DATABASE_URL=postgresql://postgres:password@localhost:5432/opal_summit

# Legacy Summit MariaDB database `sumlogs` (one-time migration from root host — use placeholders)
SUMLOGS_DATABASE_URL=mysql+pymysql://root:CHANGE_ME@opal:3306/sumlogs

# MariaDB `clients` database — users, sessions, staff, props, alloc, etc.
# This is the database the legacy PHP/Python system used for authentication.
CLIENTS_ASYNC_DATABASE_URL=mysql+aiomysql://opal:your_password@localhost:3306/clients
